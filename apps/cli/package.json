{
  "name": "@devbyai/cli",
  "version": "0.1.0",
  "description": "DEVBYAI — AI Development Orchestrator CLI",
  "type": "module",
  "main": "./dist/index.js",
  "bin": {
    "devbyai": "./dist/index.js"
  },
  "files": ["dist"],
  "scripts": {
    "build": "tsup src/index.ts --format esm --clean",
    "dev": "node dist/index.js",
    "typecheck": "tsc --noEmit",
    "clean": "node ../../scripts/clean.mjs"
  },
  "dependencies": {
    "@devbyai/agents": "workspace:*",
    "@devbyai/config": "workspace:*",
    "@devbyai/core": "workspace:*",
    "@devbyai/models": "workspace:*",
    "@devbyai/skills": "workspace:*",
    "@devbyai/tools": "workspace:*",
    "@devbyai/ui": "workspace:*",
    "chalk": "^4.1.2",
    "commander": "^12.1.0"
  },
  "devDependencies": {
    "tsup": "catalog:",
    "typescript": "catalog:"
  }
}
