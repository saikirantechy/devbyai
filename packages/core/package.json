{
  "name": "@devbyai/core",
  "version": "0.1.0",
  "description": "Core orchestrator and pipeline for DEVBYAI",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    }
  },
  "files": ["dist"],
  "scripts": {
    "build": "tsup src/index.ts --format esm --dts",
    "typecheck": "tsc --noEmit",
    "clean": "node ../../scripts/clean.mjs"
  },
  "dependencies": {
    "@devbyai/config": "workspace:*",
    "@devbyai/tools": "workspace:*",
    "@devbyai/models": "workspace:*"
  },
  "devDependencies": {
    "tsup": "catalog:",
    "typescript": "catalog:"
  }
}
